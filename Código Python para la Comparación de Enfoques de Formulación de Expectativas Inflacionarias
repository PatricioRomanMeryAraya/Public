    print(''\nResultados Finales (Métricas):'')
    df_metricas = calcular_metricas_completas(resultados)
    print(df_metricas.to_string(index=False))
    
    # 3) Visualización gráfica de predicciones y residuos
    plot_resultados(resultados, test_data)
    
