# ============================================================================
logger.info(''=== CARGANDO SERIES (EJEMPLO) ==='')

inflacion = fetch_fred_data('CPIAUCSL', start_date, end_date)
if inflacion is not None:
    inflacion = (inflacion.pct_change() * 100).bfill()
    inflacion = make_tz_naive(inflacion)
    logger.info(f''Inflación (CPIAUCSL) procesada: {len(inflacion)} observaciones'')
else:
    raise ValueError(''No se pudo obtener la serie de inflación (CPIAUCSL).'')

try:
    Tipo_cambio = fetch_Tipo_cambio(start_date, end_date)
    Tipo_cambio = make_tz_naive(Tipo_cambio)

    if isinstance(Tipo_cambio, pd.DataFrame):
        Tipo_cambio = Tipo_cambio.squeeze()
    Tipo_cambio.name = ``Tipo_cambio''

    logger.info(f''Tipo de Cambio obtenido: {len(Tipo_cambio)} observaciones'')
except ValueError as ve:
    logger.error(ve)
    raise

Tasa_interes = fetch_fred_data('FEDFUNDS', start_date, end_date)
if Tasa_interes is not None:
    Tasa_interes = make_tz_naive(Tasa_interes)
    if isinstance(Tasa_interes, pd.DataFrame):
        Tasa_interes = Tasa_interes.squeeze()
    Tasa_interes.name = ``Tasa_interes''
    logger.info(f''Interest Rate (FEDFUNDS) obtenida: {len(Tasa_interes)} observaciones'')
else:
    raise ValueError(''No se pudo obtener la serie de tasa de interés (FEDFUNDS).'')

gdp_real = fetch_fred_data('GDPC1', start_date, end_date)
gdp_potential = fetch_fred_data('GDPPOT', start_date, end_date)
if gdp_real is not None and gdp_potential is not None:
    gdp_real_monthly = gdp_real.resample('ME').ffill()
    gdp_potential_monthly = gdp_potential.resample('ME').ffill()
    Brecha_producto = (gdp_real_monthly - gdp_potential_monthly) / gdp_potential_monthly * 100
    Brecha_producto = Brecha_producto.squeeze()
    Brecha_producto = make_tz_naive(Brecha_producto)
    if isinstance(Brecha_producto, pd.DataFrame):
        Brecha_producto = Brecha_producto.squeeze()
    Brecha_producto.name = ``Brecha_producto''
    logger.info(f''Output Gap calculada: {len(Brecha_producto)} observaciones'')
else:
    raise ValueError(''No se pudo obtener la serie Brecha_producto'')

# Corrección: Obtener SP500 desde Yahoo Finance usando el ticker '^GSPC'
sp500 = fetch_yahoo_data('^GSPC', start_date, end_date)
if sp500 is not None:
    sp500 = make_tz_naive(sp500)
    sp500 = sp500.resample('ME').last()
    if isinstance(sp500, pd.DataFrame):
        sp500 = sp500.squeeze()
    sp500.name = ``SP500''
    logger.info(f''S&P 500 obtenido como proxy de S_t: {len(sp500)} observaciones'')
else:
    raise ValueError(''No se pudo obtener la serie SP500 de Yahoo Finance.'')

try:
    bond_yield = fetch_fred_data('DGS10', start_date, end_date)
    if bond_yield is not None:
        bond_yield = make_tz_naive(bond_yield)
        bond_yield = bond_yield.resample('ME').last()
        if isinstance(bond_yield, pd.DataFrame):
            bond_yield = bond_yield.squeeze()
        bond_yield.name = ``bond_yield''
        logger.info(f''Rendimiento del Tesoro a 10 años (DGS10) obtenido: {len(bond_yield)} observaciones'')
    else:
        raise ValueError(''No se pudo obtener la serie DGS10 de FRED.'')
except ValueError as ve:
    logger.error(ve)
    raise

if sp500 is not None and bond_yield is not None:
    sp500_ret = np.log(sp500).diff().dropna()
    bond_yield_ret = bond_yield.diff().dropna()
    common_index_rp = sp500_ret.index.intersection(bond_yield_ret.index)
    R_t = sp500_ret.loc[common_index_rp] - bond_yield_ret.loc[common_index_rp]
    R_t.name = 'R_t'
    logger.info(f''Prima de Riesgo (R_t) calculada: {len(R_t)} observaciones'')
else:
    raise ValueError(''No se pudo calcular la Prima de Riesgo (R_t).'')


