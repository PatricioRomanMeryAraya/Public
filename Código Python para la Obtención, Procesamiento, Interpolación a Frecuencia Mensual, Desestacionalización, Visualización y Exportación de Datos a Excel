# 3. Interpolación en el espacio de estados
# ============================================================================
def state_space_interpolation(series: pd.Series) -> pd.Series:
    model = UnobservedComponents(series, 'local level')
    try:
        results = model.fit(disp=False)
    except Exception as e:
        logger.error(f''Error al ajustar UnobservedComponents para {series.name}: {e}'')
        return series  # Retornar la serie original si falla la interpolación

    smoothed_state = results.smoothed_state

    # Verificar la forma de smoothed_state y ajustar si es necesario
    if smoothed_state.shape[0] == len(series):
        state_series = smoothed_state[:, 0]
    elif smoothed_state.shape[1] == len(series):
        state_series = smoothed_state[0, :]
    else:
        # Intentar transponer si la forma no coincide
        smoothed_state = smoothed_state.T
        if smoothed_state.shape[0] == len(series):
            state_series = smoothed_state[:, 0]
        else:
            logger.error(f''Forma inesperada de smoothed_state para {series.name}: {smoothed_state.shape}'')
            return series  # Retornar la serie original si la forma sigue siendo incorrecta

    logger.info(f''Serie {series.name}: smoothed_state shape: {smoothed_state.shape}'')
    return pd.Series(state_series, index=series.index, name=series.name)

def state_space_interpolation_df(df: pd.DataFrame) -> pd.DataFrame:
    df_new = df.copy()
    for col in df.columns:
        logger.info(f''Interpolando columna (estado local): {col}'')
        interpolated = state_space_interpolation(df[col])
        if interpolated is not None:
            df_new[col] = interpolated
        else:
            logger.warning(f''No se pudo interpolar la columna: {col}'')
    return df_new

logger.info(''=== ORGANIZANDO SERIES AL MES Y APLICANDO INTERPOLACIÓN ==='')

# Asegurarse de que todas las series tengan una frecuencia regular antes de resample
def ensure_monthly_frequency(series: pd.Series) -> pd.Series:
    if not series.index.freq:
        series = series.asfreq('M', method='ffill')
    return series

inflacion = ensure_monthly_frequency(inflacion).resample('ME').last()
Tipo_cambio = ensure_monthly_frequency(Tipo_cambio).resample('ME').last()
Tasa_interes = ensure_monthly_frequency(Tasa_interes).resample('ME').last()
Brecha_producto = ensure_monthly_frequency(Brecha_producto).resample('ME').last()
R_t = ensure_monthly_frequency(R_t).resample('ME').last()

data = pd.concat([
    inflacion.rename('inflacion'),
    Tipo_cambio.rename('Tipo_cambio'),
    Tasa_interes.rename('Tasa_interes'),
    Brecha_producto.rename('Brecha_producto'),
    sp500.rename('SP500'),
    R_t.rename('R_t')
], axis=1, join='inner')

data = state_space_interpolation_df(data)
data = data.dropna()
