# 4. Desestacionalización SARIMA
# ============================================================================
def auto_sarima_desest(series: pd.Series,
                       p_range=(0, 3),
                       d_range=(0, 2),
                       q_range=(0, 3),
                       P_range=(0, 2),
                       D_range=(0, 1),
                       Q_range=(0, 2),
                       s=12,
                       criterion='aic',
                       enforce_stationarity=False,
                       enforce_invertibility=False):
    series = series.dropna()
    best_score = float('inf')
    best_order = None
    best_seasonal_order = None
    best_model = None

    for p, d, q in itertools.product(range(p_range[0], p_range[1] + 1),
                                     range(d_range[0], d_range[1] + 1),
                                     range(q_range[0], q_range[1] + 1)):
        for P, D, Q in itertools.product(range(P_range[0], P_range[1] + 1),
                                         range(D_range[0], D_range[1] + 1),
                                         range(Q_range[0], Q_range[1] + 1)):
            try:
                order = (p, d, q)
                seasonal_order = (P, D, Q, s)
                model = SARIMAX(series,
                                order=order,
                                seasonal_order=seasonal_order,
                                enforce_stationarity=enforce_stationarity,
                                enforce_invertibility=enforce_invertibility)
                results = model.fit(disp=False)
                score = results.aic if criterion.lower() == 'aic' else results.bic
                if score < best_score:
                    best_score = score
                    best_order = order
                    best_seasonal_order = seasonal_order
                    best_model = results
            except:
                continue

    logger.info(f''Mejor orden (p,d,q): {best_order}'')
    logger.info(f''Mejor orden estacional (P,D,Q,s): {best_seasonal_order}'')
    logger.info(f''Mejor {criterion.upper()} encontrado: {best_score:.2f}'')
    return best_order, best_seasonal_order, best_model

def deseasonalize_sarima(series: pd.Series,
                         auto_select=False,
                         p_range=(0, 3),
                         d_range=(0, 2),
                         q_range=(0, 3),
                         P_range=(0, 2),
                         D_range=(0, 1),
                         Q_range=(0, 2),
                         s=12,
                         criterion='aic',
                         order=(1, 0, 1),
                         seasonal_order=(1, 1, 1, 12)):
    try:
        if auto_select:
            best_order, best_seasonal_order, best_model = auto_sarima_desest(
                series,
                p_range=p_range,
                d_range=d_range,
                q_range=q_range,
                P_range=P_range,
                D_range=D_range,
                Q_range=Q_range,
                s=s,
                criterion=criterion,
                enforce_stationarity=False,
                enforce_invertibility=False
            )
            residuals = best_model.resid
        else:
            model = SARIMAX(series,
                            order=order,
                            seasonal_order=seasonal_order,
                            enforce_stationarity=False,
                            enforce_invertibility=False)
            results = model.fit(disp=False)
            residuals = results.resid
        return residuals
    except Exception as e:
        logger.warning(f''Error al ajustar SARIMA (serie: {series.name}): {e}'')
        return series

logger.info(''=== DESESTACIONALIZANDO SERIES ==='')
data_desest = pd.DataFrame(index=data.index)
for column in data.columns:
    logger.info(f''Desestacionalizando SARIMA -> {column}'')
    data_desest[column] = deseasonalize_sarima(
        data[column],
        auto_select=True,
        p_range=(0, 3),
        d_range=(0, 2),
        q_range=(0, 3),
        P_range=(0, 2),
        D_range=(0, 1),
        Q_range=(0, 2),
        s=12,
        criterion='aic'
    )
logger.info(''Desestacionalización completada.'')

