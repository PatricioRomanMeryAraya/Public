def plot_original_series(data: pd.DataFrame) -> None:
    fig, axs = plt.subplots(3, 2, figsize=(12, 10))
    fig.suptitle('Series Originales (Interpoladas)')
    cols = list(data.columns)
    for i, col in enumerate(cols):
        ax = axs[i // 2, i % 2]
        ax.plot(data.index, data[col], label=col, color='b')
        ax.set_title(col)
        ax.legend(loc='upper left')
    plt.tight_layout()
    plt.show()

def plot_desest_series(data_desest: pd.DataFrame) -> None:
    fig, axs = plt.subplots(3, 2, figsize=(12, 10))
    fig.suptitle('Series Desestacionalizadas (Residuales SARIMA)')
    cols = list(data_desest.columns)
    for i, col in enumerate(cols):
        ax = axs[i // 2, i % 2]
        ax.plot(data_desest.index, data_desest[col], label=f''{col}_desest'', color='g')
        ax.set_title(f''{col} Desest.'')
        ax.legend(loc='upper left')
    plt.tight_layout()
    plt.show()

plot_original_series(data)
plot_desest_series(data_desest)

