# ============================================================================

def fetch_fred_data(series: str, start_date: str, end_date: str) -> pd.Series:
    ``''''
    Obtiene una serie temporal desde la API de FRED, dada la 'series key'.
    ``''''
    try:
        data = web.DataReader(series, 'fred', start_date, end_date).dropna()
        ser = data.squeeze().astype(float).dropna()
        ser.name = series
        logger.info(f''Datos FRED para {series}: {len(ser)} observaciones.'')
        return ser
    except web.DataReaderError as e:
        logger.error(f''Error al obtener la serie {series} de FRED: {e}'')
        return None
    except Exception as e:
        logger.error(f''Error inesperado al obtener la serie {series}: {e}'')
        return None

def fetch_yahoo_data(ticker: str, start_date: str, end_date: str) -> pd.Series:
    ``''''
    Obtiene datos de Yahoo Finance para un ticker específico.
    Retorna la columna 'Adj Close' como Series.
    ``''''
    try:
        data = yf.download(ticker, start=start_date, end=end_date, interval='1mo')
        if data.empty:
            logger.warning(f''No se encontraron datos para el ticker {ticker}.'')
            return None
        ser = data['Adj Close'].dropna()  # Aseguramos que sea una serie unidimensional
        ser.name = ticker
        logger.info(f''Datos Yahoo para {ticker}: {len(ser)} observaciones.'')
        return ser
    except Exception as e:
        logger.error(f''Error al obtener el ticker {ticker} de Yahoo Finance: {e}'')
        return None

def make_tz_naive(series: pd.Series) -> pd.Series:
    ``''''
    Quita la zona horaria de un índice datetime (si la tiene).
    ``''''
    if series.index.tz is not None:
        series = series.tz_localize(None)
    return series

def fetch_Tipo_cambio(start_date: str, end_date: str) -> pd.Series:
    ``''''
    Intenta obtener una serie de tipo de cambio (EUR/USD) desde Yahoo Finance o FRED.
    ``''''
    tickers_yahoo = ['EURUSD=X']
    tickers_fred  = ['DEXUSEU']

    # Primero intentamos con Yahoo
    for ticker in tickers_yahoo:
        fx = fetch_yahoo_data(ticker, start_date, end_date)
        if fx is not None:
            return fx

    # Si no funciona Yahoo, probamos con FRED
    for ticker in tickers_fred:
        fx = fetch_fred_data(ticker, start_date, end_date)
        if fx is not None:
            return fx

    raise ValueError(''No se pudo obtener la serie de tipo de cambio.'')

